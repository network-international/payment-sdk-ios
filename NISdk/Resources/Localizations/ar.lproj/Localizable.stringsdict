			<string>الإجمالي بعد شهر واحد</string>
			<key>two</key>
			<string>الإجمالي بعد شهرين</string>
			<key>few</key>
			<string>الإجمالي بعد %d أشهر</string>
			<key>many</key>
			<string>الإجمالي بعد %d شهرًا</string>
			<key>other</key>
			<string>الإجمالي بعد %d شهر</string>
		</dict>
	</dict>
	<key>slice_receipt_tenor_months</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@months@</string>
		<key>months</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
