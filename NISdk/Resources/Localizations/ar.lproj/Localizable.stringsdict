			<string>d</string>
			<key>zero</key>
			<string>%d شهر</string>
			<key>one</key>
			<string>شهر واحد</string>
			<key>two</key>
			<string>شهران</string>
			<key>few</key>
			<string>%d أشهر</string>
			<key>many</key>
			<string>%d شهرًا</string>
			<key>other</key>
			<string>%d شهر</string>
		</dict>
	</dict>
</dict>
</plist>
